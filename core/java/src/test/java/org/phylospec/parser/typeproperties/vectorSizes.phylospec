Vector<Real> repeatedCopy = repeated
Vector<Real> spaced = linspace(start=0.0, end=1.0, num=5)

Vector<PositiveReal> p = [1.0, 2.0, 3.0]
Vector<Real> r = [1.0, 2.0, 3.0]
Vector<Vector<Real>> both = [p, r]

