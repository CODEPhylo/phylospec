Alignment alignment = fromNexus(file="src/test/java/org/phylospec/resources/primate-mtDNA.nex")
PositiveInteger alignmentSites = numSites(alignment)
PositiveInteger alignmentTaxa = numTaxa(alignment)
Tree fileTree = fromTree(file="src/test/java/org/phylospec/resources/valid.newick")
Tree parsedTree = fromNewick(newickString="((A, B), C);")
PositiveInteger treeTaxa = numTaxa(parsedTree)
PositiveInteger treeBranches = numBranches(parsedTree)

