Alignment data = fromNexus("/Users/ochsneto/Documents/PhyloSpec/phylospec/benchmark/primate-mtDNA.nex")

Tree tree ~ Yule(
    birthRate=1.0, taxa=taxa(data)
)

Rate kappa ~ LogNormal(logMean=1.0, logSd=0.5)
Alignment alignment ~ PhyloCTMC(
  tree,
  branchRates~StrictClock(clockRate=1.0, tree),
  qMatrix=hky(
    kappa, baseFrequencies~Dirichlet(repeat(1.0, num=4))
  ),
) observed as data

mcmc {
  Integer chainLength = 10000
}