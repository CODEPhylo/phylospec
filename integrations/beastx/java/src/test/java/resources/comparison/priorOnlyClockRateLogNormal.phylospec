PositiveReal clockRate ~ LogNormal(
    logMean=-6.9,
    logSd=0.5
)

mcmc {
    Integer chainLength = 10000000
    Integer randomSeed = 1234

    Logger fileLogger = fileLogger(
        logEvery=1000,
        file="target/comparison-diagnostics/beastx-prior-only-clockrate-lognormal.log",
        parameters=[posterior, prior, likelihood, "clockRate_prior", clockRate]
    )
}
