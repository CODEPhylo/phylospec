Alignment data = fromNexus("src/test/java/resources/comparison/H1N1pdm_2009.nex")

Taxa taxa = taxa(data)

PositiveReal populationSize ~ LogNormal(
    logMean=0.0,
    logSd=1.0
)

PositiveReal growthRate ~ LogNormal(
    logMean=0.0,
    logSd=1.0
)

Rate clockRate ~ LogNormal(
    logMean=-5.8,
    logSd=1.0
)

PositiveReal kappa ~ LogNormal(
    logMean=1.0,
    logSd=1.5
)

Simplex baseFrequencies ~ Dirichlet(
    concentration=[3.0, 3.0, 3.0, 3.0]
)

PositiveReal gammaShape ~ LogNormal(
    logMean=0.0,
    logSd=0.5
)

Tree tree ~ Coalescent(
    populationSize=exponentialPopulationFunction(
        populationSize=populationSize,
        growthRate=growthRate
    ),
    taxa=taxa
)

Vector<Rate> branchRates ~ StrictClock(
    clockRate=clockRate,
    tree=tree
)

Vector<Rate> siteRates ~ DiscreteGammaInv(
    shape=gammaShape,
    numCategories=4,
    numSites=numSites(data)
)

QMatrix qMatrix = hky(
    kappa=kappa,
    baseFrequencies=baseFrequencies
)

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=qMatrix,
    branchRates=branchRates,
    siteRates=siteRates
) observed as data

mcmc {
    Integer chainLength = 10000000
    Integer randomSeed = 1234

    Logger fileLogger = fileLogger(
        logEvery=1000,
        file="target/comparison/tutorial-h1n1-exponential-coalescent-hky-gamma-beastx.log",
        parameters=[
            "posterior",
            "prior",
            "likelihood",
            "tree.height",
            "tree.treeLength",
            populationSize,
            growthRate,
            clockRate,
            kappa,
            baseFrequencies,
            gammaShape
        ]
    )

    Logger treeLogger = treeLogger(
        logEvery=1000,
        file="target/comparison/tutorial-h1n1-exponential-coalescent-hky-gamma-beastx.trees",
        trees=[tree]
    )
}