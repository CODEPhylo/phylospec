Alignment data = fromNexus(
    file="src/test/java/resources/comparison/phases/phase1/testHKY.nex"
)

Taxa taxa = taxa(data)

PositiveReal kappa ~ LogNormal(
    logMean=1.0,
    logSd=0.5
)

Simplex baseFrequencies ~ Dirichlet(
    concentration=repeat(1.0, num=4)
)

PositiveReal gammaShape ~ LogNormal(
    logMean=0.0,
    logSd=0.5
)

Tree tree ~ Yule(
    birthRate=1.0,
    taxa=taxa
)

Vector<Rate> siteRates ~ DiscreteGammaInv(
    shape=gammaShape,
    numCategories=4,
    numSites=numSites(data)
)

QMatrix qMatrix = hky(
    kappa=kappa,
    baseFrequencies=baseFrequencies
)

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=qMatrix,
    siteRates=siteRates
) observed as data

mcmc {
    Integer chainLength = 10000000
    Integer randomSeed = 1234

    Logger fileLogger = fileLogger(
        logEvery=1000,
        file="target/comparison-diagnostics/phylo-beastx-phase2-hky-gamma-estimated-tree.log",
        parameters=[
            "posterior",
            "prior",
            "likelihood",
            "alignment_likelihood",
            "tree_prior",
            "kappa_prior",
            "gammaShape_prior",
            kappa,
            baseFrequencies,
            gammaShape,
            "tree.height",
            "tree.treeLength"
        ]
    )

    Logger treeLogger = treeLogger(
        logEvery=1000,
        file="target/comparison-diagnostics/phylo-beastx-phase2-hky-gamma-estimated-tree.trees",
        trees=[tree]
    )
}
