Alignment data = fromNexus(
    file="src/test/java/resources/comparison/H1N1pdm_2009.nex",
    date=parse(regex=".*_(\d+(?:\.\d+)?)$")
)

Taxa taxa = taxa(data)

PositiveReal populationSize = 1.0
PositiveReal growthRate = 0.1

Rate clockRate = 0.0001

PositiveReal kappa ~ LogNormal(
    logMean=1.0,
    logSd=0.5
)

Simplex baseFrequencies = [0.335, 0.193, 0.242, 0.230]

PositiveReal gammaShape = 0.1

Tree tree ~ Coalescent(
    populationSize=exponentialPopulationFunction(
        populationSize=populationSize,
        growthRate=growthRate
    ),
    taxa=taxa
)

Vector<Rate> branchRates ~ StrictClock(
    clockRate=clockRate,
    tree=tree
)

Vector<Rate> siteRates ~ DiscreteGammaInv(
    shape=gammaShape,
    numCategories=4,
    invariantProportion=0.0,
    numSites=numSites(data)
)

QMatrix qMatrix = hky(
    kappa=kappa,
    baseFrequencies=baseFrequencies
)

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=qMatrix,
    branchRates=branchRates,
    siteRates=siteRates
) observed as data

mcmc {
    Integer chainLength = 2000000
    Integer randomSeed = 1234
    Real treeScaleFactor = 0.1
    Real treeClockUpDownWeight = 0.0

    Logger fileLogger = fileLogger(
        logEvery=1000,
        file="target/comparison-diagnostics/beastx-fixed-population-exponential-coalescent-hky-gamma.log",
        parameters=[
            "posterior",
            "prior",
            "likelihood",
            "kappa_prior",
            "tree_prior",
            "alignment_likelihood",
            "tree.height",
            "tree.treeLength",
            kappa
        ]
    )

    Logger treeLogger = treeLogger(
        logEvery=1000,
        file="target/comparison-diagnostics/beastx-fixed-population-exponential-coalescent-hky-gamma.trees",
        trees=[tree]
    )
}
