Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Taxa taxa = taxa(data)
Tree tree ~ Yule(birthRate=1.0, taxa=taxa)

Vector<Rate> branchRates ~ RelaxedClock(
    clockRate=1.0,
    base=LogNormal(mean=1.0, logSd=0.1),
    tree=tree
)

