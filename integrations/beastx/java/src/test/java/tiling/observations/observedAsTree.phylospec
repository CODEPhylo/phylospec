Tree treeData = fromNewick(
    "((A:1.0,B:1.0):1.0,(C:1.0,D:1.0):1.0);"
)

PositiveReal birthRate ~ LogNormal(
    logMean=0.0,
    logSd=1.0
)

Tree tree ~ Yule(
    birthRate=birthRate,
    taxa=taxa(treeData)
) observed as treeData

