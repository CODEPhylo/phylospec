Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Taxa taxa = taxa(data)
Tree tree ~ Yule(birthRate=1.0, taxa=taxa)
QMatrix qMatrix = jc69()
Vector<Real> siteRates = [1.0, 0.5, 1.5, 1.0]

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=qMatrix,
    siteRates=siteRates
) observed as data

