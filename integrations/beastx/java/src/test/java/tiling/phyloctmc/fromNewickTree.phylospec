Alignment data = fromFasta("src/test/java/resources/simple.fasta")
Tree tree = fromNewick("((taxon1:0.1,taxon2:0.1):0.2,(taxon3:0.1,taxon4:0.1):0.2);")
QMatrix qMatrix = jc69()

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=qMatrix
) observed as data

