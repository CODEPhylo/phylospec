Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Taxa taxa = taxa(data)

Rate birthRate ~ LogNormal(logMean=0.0, logSd=1.0)

Tree tree ~ Yule(
    birthRate=birthRate,
    taxa=taxa
)

Age humanChimp = mrca(
    clade=["Homo_sapiens", "Pan"],
    tree=tree
) observed between [1.0, 10.0]

QMatrix qMatrix = hky(
    kappa~LogNormal(logMean=1.0, logSd=0.5),
    baseFrequencies=[0.25, 0.25, 0.25, 0.25]
)

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=qMatrix,
    branchRates~StrictClock(clockRate=1.0, tree=tree)
) observed as data

// EXPECTED_TILES
// TILING_SUCCESS
// TILING_SUCCESS
// EXPECTED_TILES

