Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Taxa taxa = taxa(data)

Tree tree ~ Yule(
    birthRate=1.0,
    taxa=taxa
)

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=hky(
        kappa~LogNormal(logMean=1.0, logSd=0.5),
        baseFrequencies~Dirichlet(concentration=repeat(1.0, num=4))
    )
) observed as data

// EXPECTED_TILES
// TILING_SUCCESS
// EXPECTED_TILES

// EXPECTED BEASTX STATE
// SN: kappa, baseFrequencies
// P: kappa_prior, baseFrequencies_prior
// TM: tree
// TP: tree_prior
// L: alignment_likelihood
