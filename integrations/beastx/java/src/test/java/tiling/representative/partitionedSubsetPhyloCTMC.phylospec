Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Alignment firstPartition = subset(alignment=data, start=1, end=300)
Alignment secondPartition = subset(alignment=data, start=301, end=600)

Taxa taxa = taxa(data)

Rate birthRate ~ LogNormal(logMean=0.0, logSd=1.0)

Tree tree ~ Yule(
    birthRate=birthRate,
    taxa=taxa
)

QMatrix firstQ = jc69()

QMatrix secondQ = hky(
    kappa~LogNormal(logMean=1.0, logSd=0.5),
    baseFrequencies=[0.25, 0.25, 0.25, 0.25]
)

Alignment firstAlignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=firstQ
) observed as firstPartition

Alignment secondAlignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=secondQ
) observed as secondPartition

// EXPECTED_TILES
// TILING_SUCCESS
// TILING_SUCCESS
// EXPECTED_TILES

// EXPECTED BEASTX STATE
// SN: birthRate, kappa
// P: birthRate_prior, kappa_prior
// TM: tree
// TP: tree_prior
// L: firstAlignment_likelihood, secondAlignment_likelihood
