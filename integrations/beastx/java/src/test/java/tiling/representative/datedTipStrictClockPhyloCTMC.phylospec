Alignment data = fromNexus(
    file="src/test/java/resources/dated-simple.nex",
    age=parse(regex=".*_(\d+(?:\.\d+)?)$")
)

Taxa taxa = taxa(data)

Tree tree ~ Yule(
    birthRate=1.0,
    rootAge=5.0,
    taxa=taxa
)

Rate clockRate ~ LogNormal(
    logMean=0.0,
    logSd=0.5
)

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=jc69(),
    branchRates~StrictClock(
        clockRate=clockRate,
        tree=tree
    )
) observed as data

// EXPECTED_TILES
// TILING_SUCCESS
// EXPECTED_TILES

// EXPECTED BEASTX STATE
// SN: clockRate
// P: clockRate_prior
// TM: tree
// TP: tree_prior
// L: alignment_likelihood
