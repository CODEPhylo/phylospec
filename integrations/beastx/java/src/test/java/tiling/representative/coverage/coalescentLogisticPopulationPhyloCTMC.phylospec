Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Taxa taxa = taxa(data)

Age inflectionAge ~ Gamma(
    shape=2.0,
    rate=1.0
)

PositiveReal carryingCapacity ~ LogNormal(
    logMean=2.0,
    logSd=0.5
)

Real growthRate ~ Normal(
    mean=0.5,
    sd=0.2
)

PopulationFunction populationFunction = logisticPopulationFunction(
    inflectionAge=inflectionAge,
    carryingCapacity=carryingCapacity,
    growthRate=growthRate
)

Tree tree ~ Coalescent(
    populationSize=populationFunction,
    taxa=taxa
)

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=hky(
        kappa~LogNormal(logMean=1.0, logSd=0.5),
        baseFrequencies~Dirichlet(concentration=repeat(value=1.0, num=4))
    )
) observed as data

// EXPECTED_TILES
// TILING_SUCCESS
// EXPECTED_TILES

// EXPECTED BEASTX STATE
// SN: inflectionAge, carryingCapacity, growthRate, kappa, baseFrequencies
// P: inflectionAge_prior, carryingCapacity_prior, growthRate_prior, kappa_prior, baseFrequencies_prior
// TM: tree
// TP: tree_prior
// L: alignment_likelihood
