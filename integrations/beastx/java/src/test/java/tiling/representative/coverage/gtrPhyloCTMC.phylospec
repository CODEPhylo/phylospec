Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Taxa taxa = taxa(data)

Tree tree ~ Yule(
    birthRate=1.0,
    taxa=taxa
)

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=gtr(
        rateAC~LogNormal(logMean=0.0, logSd=0.5),
        rateAG~LogNormal(logMean=0.0, logSd=0.5),
        rateAT~LogNormal(logMean=0.0, logSd=0.5),
        rateCG~LogNormal(logMean=0.0, logSd=0.5),
        rateCT~LogNormal(logMean=0.0, logSd=0.5),
        rateGT~LogNormal(logMean=0.0, logSd=0.5),
        baseFrequencies~Dirichlet(concentration=repeat(1.0, num=4))
    )
) observed as data

// EXPECTED_TILES
// TILING_SUCCESS
// EXPECTED_TILES

// EXPECTED BEASTX STATE
// SN: rateAC, rateAG, rateAT, rateCG, rateCT, rateGT, baseFrequencies
// P: rateAC_prior, rateAG_prior, rateAT_prior, rateCG_prior, rateCT_prior, rateGT_prior, baseFrequencies_prior
// TM: tree
// TP: tree_prior
// L: alignment_likelihood
