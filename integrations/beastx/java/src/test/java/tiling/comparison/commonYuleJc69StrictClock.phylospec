Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")

Taxa taxa = taxa(data)

Tree tree ~ Yule(
    birthRate=1.0,
    taxa=taxa
)

Rate clockRate ~ LogNormal(
    logMean=0.0,
    logSd=1.0
)

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=jc69(),
    branchRates~StrictClock(
        clockRate=clockRate,
        tree=tree
    )
) observed as data

mcmc {
    Integer chainLength = 10000

    Logger screenLogger = screenLogger(
        logEvery=1000,
        parameters=[
            "posterior",
            "prior",
            "likelihood",
            clockRate
        ]
    )

    Logger fileLogger = fileLogger(
        logEvery=1000,
        file="target/comparison/common-yule-jc69-strictclock-beastx.log",
        parameters=[
            "posterior",
            "prior",
            "likelihood",
            clockRate
        ]
    )

    Logger treeLogger = treeLogger(
        logEvery=1000,
        file="target/comparison/common-yule-jc69-strictclock-beastx.trees",
        trees=[tree]
    )
}