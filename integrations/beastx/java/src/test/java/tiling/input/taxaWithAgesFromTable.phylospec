Tree sourceTree = fromTree("src/test/java/resources/valid.newick")
Taxa rawTaxa = taxa(sourceTree)

Vector<Map<String, String>> metadata = fromCSV(
    file="src/test/java/resources/dated-metadata.csv"
)

Taxa datedTaxa = taxaWithAgesFromTable(
    taxa=rawTaxa,
    table=metadata,
    taxonColumn="taxon",
    ageColumn="age"
)

Tree tree ~ Yule(
    birthRate=1.0,
    taxa=datedTaxa
)

