Tree tree = fromTree("src/test/java/resources/valid.newick")
Taxa taxa = taxa(tree)

Vector<Map<String, String>> metadata = fromCSV(
    file="src/test/java/resources/metadata.csv"
)

Alignment traits = discreteTraitsFromTable(
    taxa=taxa,
    table=metadata,
    taxonColumn="taxon",
    traitColumn="trait"
)

