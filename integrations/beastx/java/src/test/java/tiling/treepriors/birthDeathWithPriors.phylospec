Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Taxa taxa = taxa(data)

Real diversificationRate ~ LogNormal(logMean=0.0, logSd=1.0)
Real turnover ~ Beta(alpha=2.0, beta=2.0)

Tree tree ~ BirthDeath(
    diversificationRate=diversificationRate,
    turnover=turnover,
    taxa=taxa
)

// EXPECTED_TILES
// TILING_SUCCESS
