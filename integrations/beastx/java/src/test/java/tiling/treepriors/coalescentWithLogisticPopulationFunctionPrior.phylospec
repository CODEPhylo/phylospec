Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Taxa taxa = taxa(data)

Age inflectionAge ~ Gamma(
    shape=2.0,
    rate=1.0
)

PositiveReal carryingCapacity ~ LogNormal(
    logMean=2.0,
    logSd=0.5
)

Real growthRate ~ Normal(
    mean=0.5,
    sd=0.2
)

PopulationFunction populationFunction = logisticPopulationFunction(
    inflectionAge=inflectionAge,
    carryingCapacity=carryingCapacity,
    growthRate=growthRate
)

Tree tree ~ Coalescent(
    populationSize=populationFunction,
    taxa=taxa
)

// EXPECTED_TILES
// TILING_SUCCESS
// EXPECTED_TILES

// EXPECTED BEASTX STATE
// SN: inflectionAge, carryingCapacity, growthRate
// P: inflectionAge_prior, carryingCapacity_prior, growthRate_prior
// TM: tree
// TP: tree_prior
// EXPECTED BEASTX STATE