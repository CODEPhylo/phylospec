Real rootAge ~ Gamma(rate=1.0, shape=2.0)
Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Taxa taxa = taxa(data)
Tree tree ~ Yule(birthRate=1.0, rootAge=rootAge, taxa=taxa)

