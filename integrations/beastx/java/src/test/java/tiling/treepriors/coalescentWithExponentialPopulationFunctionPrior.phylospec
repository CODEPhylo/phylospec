Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Taxa taxa = taxa(data)

PositiveReal populationSize ~ LogNormal(logMean=0.0, logSd=1.0)
Real growthRate ~ Normal(mean=0.0, sd=1.0)

Tree tree ~ Coalescent(
    populationSize=exponentialPopulationFunction(
        populationSize=populationSize,
        growthRate=growthRate
    ),
    taxa=taxa
)

// EXPECTED_TILES
// TILING_SUCCESS
// EXPECTED_TILES

// EXPECTED BEASTX STATE
// SN: populationSize, growthRate
// P: populationSize_prior, growthRate_prior
// TM: tree
// TP: tree_prior
