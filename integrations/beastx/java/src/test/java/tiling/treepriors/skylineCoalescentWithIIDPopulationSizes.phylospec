Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Taxa taxa = taxa(data)

RealVector<PositiveReal> populationSizes ~ IID(
    base=LogNormal(logMean=4.5, logSd=1.0),
    num=3
)

Tree tree ~ SkylineCoalescent(
    populationSizes=populationSizes,
    changeTimes=[1.0, 3.0],
    taxa=taxa
)

