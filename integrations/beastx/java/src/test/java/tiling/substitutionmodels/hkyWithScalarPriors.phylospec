Real kappaExp ~ Exponential(rate=2.0)
QMatrix hkyExp = hky(
    kappa = kappaExp,
    baseFrequencies = repeat(0.25, num=4)
)

Real kappaGamma ~ Gamma(shape=2.0, rate=1.0)
QMatrix hkyGamma = hky(
    kappa = kappaGamma,
    baseFrequencies = repeat(0.25, num=4)
)

Real kappaLogNormal ~ LogNormal(logMean=0.0, logSd=1.0)
QMatrix hkyLogNormal = hky(
    kappa = kappaLogNormal,
    baseFrequencies = repeat(0.25, num=4)
)

Real kappaLogNormalRealSpace ~ LogNormal(mean=2.0, logSd=0.5)
QMatrix hkyLogNormalRealSpace = hky(
    kappa = kappaLogNormalRealSpace,
    baseFrequencies = repeat(0.25, num=4)
)

