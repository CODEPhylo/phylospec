Alignment data = fromNexus(
    file="src/test/java/resources/comparison/H1N1pdm_2009.nex",
    date=parse(regex=".*_(\d+(?:\.\d+)?)$")
)

Taxa taxa = taxa(data)

PositiveReal populationSize = 0.5

PositiveReal growthRate = 0.000000001

Tree tree ~ Coalescent(
    populationSize=exponentialPopulationFunction(
        populationSize=populationSize,
        growthRate=growthRate
    ),
    taxa=taxa
)

mcmc {
    Integer chainLength = 1
    Integer randomSeed = 1234
}