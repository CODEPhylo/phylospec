Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")

Tree tree ~ Yule(
    birthRate=1.0, taxa=taxa(data)
)

Simplex partitionWeights ~ Dirichlet(concentration=[1.0, 1.0])

Alignment first ~ PhyloCTMC(
  tree, qMatrix=jc69(), rate=-2.0 * partitionWeights[1]
) observed as data

