Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Tree tree ~ Yule(
    birthRate=1.0,
    taxa=taxa(data)
)

Age calibratedRoot = rootAge(
    tree=tree
) observed between [0.0, 10.0]

