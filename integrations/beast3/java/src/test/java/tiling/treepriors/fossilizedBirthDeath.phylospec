Age rootAge ~ Gamma(rate=1.0, shape=2.0)
Alignment data = fromNexus("src/test/java/resources/primate-mtDNA.nex")
Tree tree ~ FossilizedBirthDeath(
    speciationRate=1.0,
    extinctionRate=0.2,
    serialSamplingRate=0.1,
    samplingProbability=0.8,
    rootAge=rootAge,
    taxa=taxa(data)
)

