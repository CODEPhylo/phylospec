// Weighted-rate prior and data preparation from the RSV2 tutorial.
data {
    Alignment D = fromNexus(file="RSV2.nex", date=parse(regex=".*s(\d+)$"))
    Vector<PositiveInteger> p = [3, 1, 2]
    Alignment codon[i] = subset(alignment=D, start=1, end=629, codonPosition=p[i]) for i in 1:3
    PositiveInteger L[i] = numSites(codon[i]) for i in 1:3
}
model {
    Vector<PositiveReal> r ~ WeightedDirichlet(concentration=[1.0, 1.0, 1.0], weights=L, mean=1.0)
}
