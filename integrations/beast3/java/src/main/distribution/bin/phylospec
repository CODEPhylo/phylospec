#!/bin/sh
# Run the installed distribution without changing the caller's working directory.

fail() {
    printf 'PhyloSpec: %s\n' "$1" >&2
    exit 1
}

phylospec_launcher=$0
case "$phylospec_launcher" in
    */*) ;;
    *) phylospec_launcher=$(command -v "$phylospec_launcher") || fail "Cannot locate the launcher." ;;
esac
case "$phylospec_launcher" in
    /*) ;;
    *) phylospec_launcher=$(pwd -P)/$phylospec_launcher ;;
esac

# Resolve links one at a time; readlink -f is unavailable on some supported systems.
phylospec_links=0
while [ -L "$phylospec_launcher" ]; do
    phylospec_links=$((phylospec_links + 1))
    [ "$phylospec_links" -le 40 ] || fail "Too many launcher symbolic links."
    phylospec_link_dir=$(CDPATH= cd -P "${phylospec_launcher%/*}" && pwd -P) || fail "Cannot locate the launcher directory."
    phylospec_link=$(readlink "$phylospec_launcher") || fail "Cannot resolve the launcher symbolic link."
    case "$phylospec_link" in
        /*) phylospec_launcher=$phylospec_link ;;
        *) phylospec_launcher=$phylospec_link_dir/$phylospec_link ;;
    esac
done
phylospec_home=$(CDPATH= cd -P "${phylospec_launcher%/*}/.." && pwd -P) || fail "Cannot locate the installation directory."

phylospec_has_jar=false
for phylospec_jar in "$phylospec_home"/lib/*.jar; do
    if [ -f "$phylospec_jar" ]; then
        phylospec_has_jar=true
        break
    fi
done
[ "$phylospec_has_jar" = true ] || fail "No runtime JARs found in $phylospec_home/lib. Extract the complete distribution."

if [ -n "${JAVA_HOME:-}" ]; then
    phylospec_java=$JAVA_HOME/bin/java
    [ -x "$phylospec_java" ] || fail "JAVA_HOME does not contain an executable bin/java: $JAVA_HOME"
else
    phylospec_java=$(command -v java) || fail "Java 25 or newer is required. Set JAVA_HOME or put java on PATH."
fi

phylospec_version_output=$("$phylospec_java" -version 2>&1) || fail "Java could not start. Check JAVA_HOME and the Java installation."
case "$phylospec_version_output" in
    *version\ \"*)
        phylospec_version=${phylospec_version_output#*version \"}
        phylospec_version=${phylospec_version%%\"*}
        phylospec_major=${phylospec_version%%[.-]*}
        ;;
    *) fail "Cannot determine the Java version. Java 25 or newer is required." ;;
esac
case "$phylospec_major" in
    ''|*[!0-9]*) fail "Cannot determine the Java version. Java 25 or newer is required." ;;
esac
[ "$phylospec_major" -ge 25 ] || fail "Java 25 or newer is required; found $phylospec_version. Set JAVA_HOME or update java on PATH."

# Platform distributions carry a private CPU-only BEAGLE build. Its native dependencies
# and plugins resolve beside the library, without Homebrew or global loader variables.
phylospec_native=$phylospec_home/native/macos-arm64
if [ -d "$phylospec_home/native" ]; then
    [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || fail "This BEAGLE distribution requires macOS on Apple Silicon. Use the generic CLI ZIP on other platforms."
    [ -d "$phylospec_native" ] || fail "Bundled BEAGLE directory is missing. Extract the complete distribution."
    phylospec_java_settings=$("$phylospec_java" -XshowSettings:properties -version 2>&1) || fail "Cannot inspect the Java architecture."
    phylospec_java_arch=$(printf '%s\n' "$phylospec_java_settings" | sed -n 's/^[[:space:]]*os.arch = //p')
    case "$phylospec_java_arch" in
        aarch64|arm64) ;;
        *) fail "Bundled BEAGLE requires an ARM64 Java installation; found $phylospec_java_arch. Set JAVA_HOME to ARM64 Java 25 or newer." ;;
    esac
    for phylospec_library in libhmsbeagle-jni.jnilib libhmsbeagle.1.dylib libhmsbeagle-cpu.40.so; do
        [ -f "$phylospec_native/$phylospec_library" ] || fail "Bundled BEAGLE library is missing: $phylospec_library. Extract the complete distribution."
    done
    exec "$phylospec_java" --enable-native-access=ALL-UNNAMED \
        "-Djava.library.path=$phylospec_native" -Dbeagle.resource.order=0 \
        -cp "$phylospec_home/lib/*" runner.PhyloSpecCli "$@"
fi

# The generic distribution retains BEAST's optional native discovery and Java fallback.
exec "$phylospec_java" --enable-native-access=ALL-UNNAMED -cp "$phylospec_home/lib/*" runner.PhyloSpecCli "$@"
