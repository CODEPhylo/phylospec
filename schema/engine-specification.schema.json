{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://phylospec.org/schemas/engine-specification-schema-v1.json",
  "title": "Engine Specification Schema v1",
  "description": "Schema for validating engine specifications describing an inference engine's generators and installation metadata",
  "type": "object",
  "required": [
    "name",
    "engineVersion",
    "dependsOn",
    "generators",
    "installationInstructions",
    "installationWebsite"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the engine"
    },
    "engineVersion": {
      "type": "string",
      "description": "Version of the engine this specification targets"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of other engines this engine depends on"
    },
    "generators": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/generator"
      }
    },
    "installationInstructions": {
      "type": "string",
      "description": "Human-readable instructions for installing the engine"
    },
    "installationWebsite": {
      "type": "string",
      "description": "URL of the website with installation information for the engine"
    }
  },
  "definitions": {
    "generator": {
      "type": "object",
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace for this generator"
        },
        "generatedType": {
          "type": "string",
          "description": "Type generated by this generator"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/argument"
          }
        }
      }
    },
    "argument": {
      "type": "object",
      "required": [
        "name",
        "required",
        "canBeStochastic"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "description": "Whether this argument is required"
        },
        "canBeStochastic": {
          "type": "boolean",
          "description": "Whether this argument can be a stochastic node"
        }
      }
    }
  }
}
