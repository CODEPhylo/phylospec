Alignment data = fromNexus(
    file="${REPOSITORY_ROOT}/validation/examples/testHKY/testHKY.nex"
)

Taxa taxa = taxa(data)

Simplex baseFrequencies ~ Dirichlet(
    concentration=[1.0, 1.0, 1.0, 1.0]
)

QMatrix qMatrix = f81(
    baseFrequencies=baseFrequencies
)

Tree tree ~ Yule(
    birthRate=1.0,
    taxa=taxa
)

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=qMatrix
) observed as data

mcmc {
    Integer chainLength = 5000000
    Integer randomSeed = 1234
}
