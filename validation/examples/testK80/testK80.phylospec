Alignment data = fromNexus(
    file="${REPOSITORY_ROOT}/validation/examples/testHKY/testHKY.nex"
)

Taxa taxa = taxa(data)

PositiveReal kappa ~ LogNormal(
    logMean=1.0,
    logSd=0.5
)

QMatrix qMatrix = k80(
    kappa=kappa
)

Tree tree ~ Yule(
    birthRate=1.0,
    taxa=taxa
)

Alignment alignment ~ PhyloCTMC(
    tree=tree,
    qMatrix=qMatrix
) observed as data

mcmc {
    Integer chainLength = 5000000
    Integer randomSeed = 1234
}
