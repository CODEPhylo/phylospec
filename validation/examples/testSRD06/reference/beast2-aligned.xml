<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<beast version="2.0"
       namespace="beast.base.evolution.alignment:beast.pkgmgmt:beast.base.core:beast.base.inference:beast.base.inference.distribution:beast.base.evolution.tree.coalescent:beast.base.evolution.speciation:beast.base.inference.util:beast.evolution.nuc:beast.base.evolution.operator:beast.base.inference.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.likelihood">

  <!--
      Controlled SRD06 comparison model:
      * codon positions 1 and 2 share one HKY parameterization;
      * codon position 3 uses a second HKY parameterization;
      * all three likelihood components share one tree and one fixed unit clock;
      * tree ~ Coalescent(ConstantPopulation(populationSize));
      * kappa parameters ~ LogNormal(logMean=1.0, logSd=0.5);
      * frequency vectors ~ Dirichlet(1,1,1,1);
      * populationSize ~ LogNormal(logMean=0.0, logSd=1.0).
  -->

  <data dataType="nucleotide" id="Primates">
        <sequence id="seq_Tarsius_syrichta" taxon="Tarsius_syrichta" totalcount="4" value="-TGCAAGAACTGCTAACTCATGCCTCCATATATAACAATGTGGCTTTCTT-ACTTTTAAAGGATAGAAGTAATCCATCGGTCTTAGGAACCGAAAA-ATTGGTGCAACTCCAAATAAAAGTAATAAATTTATTTTCATCCTCCATTTTACTATCACTTACACTCTTAATTACCCCATTTATTATTACAACAACTAAAAAATATGAAACACATGCATACCCTTACTACGTAAAAAACTCTATCGCCTGCGCATTTATAACAAGCCTAGTCCCAATGCTCATATTTCTATACACAAATCAAGAAATAATCATTTCCAACTGACATTGAATAACGATTCATACTATCAAATTATGCCTAAGCTT"/>
        <sequence id="seq_Lemur_catta" taxon="Lemur_catta" totalcount="4" value="-AAAACACTAGATTGTGAATCCAGAAATAGAAGCTCAAAC-CTTCTTATTTACCGAGAAAGTAATGTATGAACTGCTAACTCTGCACTCCGTATATAAAAATACGGCTATCTCAACTTTTAAAGGATAGAAGTAATCCATTGGCCTTAGGAGCCAAAAA-ATTGGTGCAACTCCAAATAAAAGTAATAAATCTATTATCCTCTTTCACCCTTGTCACACTGATTATCCTAACTTTACCTATCATTATAAACGTTACAAACATATACAAAAACTACCCCTATGCACCATACGTAAAATCTTCTATTGCATGTGCCTTCATCACTAGCCTCATCCCAACTATATTATTTATCTCCTCAGGACAAGAAACAATCATTTCCAACTGACATTGAATAACAATCCAAACCCTAAAACTATCTATTAGCTT"/>
        <sequence id="seq_Homo_sapiens" taxon="Homo_sapiens" totalcount="4" value="-CGACCCCTTATTTACCGAGAAAGCT-"/>
        <sequence id="seq_Pan" taxon="Pan" totalcount="4" value="-CGACCCCTTATTTACCGAGAAAGCT-"/>
        <sequence id="seq_Gorilla" taxon="Gorilla" totalcount="4" value="-CAACCCCTTATTTACCGAGAAAGCT-"/>
        <sequence id="seq_Pongo" taxon="Pongo" totalcount="4" value="-CAACCCCTTATTTACCGAGAAAGCT-CACAAGAACTGCTAACTCTCACT-"/>
        <sequence id="seq_Hylobates" taxon="Hylobates" totalcount="4" value="-AAACCTCTTGCTTACCGAGAAAGCC-"/>
        <sequence id="seq_Macaca_fuscata" taxon="Macaca_fuscata" totalcount="4" value="-CCACCTCTTATTTACCGAGAAAACT-"/>
        <sequence id="seq_M_mulatta" taxon="M_mulatta" totalcount="4" value="-CCACCTCTTATTTACCGAGAAAACT-"/>
        <sequence id="seq_M_fascicularis" taxon="M_fascicularis" totalcount="4" value="-CCACTTCTTATTTACCGAGAAAACT-"/>
        <sequence id="seq_M_sylvanus" taxon="M_sylvanus" totalcount="4" value="-CCACTTCTTATTTACCGAGAAAACT-"/>
        <sequence id="seq_Saimiri_sciureus" taxon="Saimiri_sciureus" totalcount="4" value="-TAACTTCTTAATTACCGAGAAAGTG-CGCAAGAACTGCTAATTCATGCTCCCAAGACTAACAACTTGGCTTCCTCAACTTTTAAAGGATAGTAGTTATCCATTGGTCTTAGGAGCCAAAAACATTGGTGCAACTCCAAATAAAAGTAATA---ATACACTTCTCCATCACTCTAATAACACTAATTAGCCTACTAGCGCCAATCCTAGCTACCCTCATTAACCCTAACAAAAGCACACTATACCCGTACTACGTAAAACTAGCCATCATCTACGCCCTCATTACCAGTACCTTATCTATAATATTCTTTATCCTTACAGGCCAAGAATCAATAATTTCAAACTGACACTGAATAACTATCCAAACCATCAAACTATCCCTAAGCTT"/>
    </data>

  <data data="@Primates" dataType="nucleotide" filter="1::3"
        id="firstCodonPositions" spec="FilteredAlignment"/>
  <data data="@Primates" dataType="nucleotide" filter="2::3"
        id="secondCodonPositions" spec="FilteredAlignment"/>
  <data data="@Primates" dataType="nucleotide" filter="3::3"
        id="thirdCodonPositions" spec="FilteredAlignment"/>

  <input spec="HKY" id="firstSecondHky">
    <kappa idref="firstSecondKappa"/>
    <frequencies id="firstSecondFrequencies" spec="Frequencies"
                 frequencies="@firstSecondBaseFrequencies"/>
  </input>

  <input spec="HKY" id="thirdHky">
    <kappa idref="thirdKappa"/>
    <frequencies id="thirdFrequencies" spec="Frequencies"
                 frequencies="@thirdBaseFrequencies"/>
  </input>

  <input spec="SiteModel" id="firstSecondSiteModel" gammaCategoryCount="1">
    <substModel idref="firstSecondHky"/>
  </input>

  <input spec="SiteModel" id="thirdSiteModel" gammaCategoryCount="1">
    <substModel idref="thirdHky"/>
  </input>

  <input spec="TreeLikelihood" id="firstCodonAlignment_likelihood">
    <data idref="firstCodonPositions"/>
    <tree idref="tree"/>
    <siteModel idref="firstSecondSiteModel"/>
    <branchRateModel id="strictClock"
                     spec="beast.base.evolution.branchratemodel.StrictClockModel">
      <parameter estimate="false" id="clockRate"
                 name="clock.rate" value="1.0"/>
    </branchRateModel>
  </input>

  <input spec="TreeLikelihood" id="secondCodonAlignment_likelihood">
    <data idref="secondCodonPositions"/>
    <tree idref="tree"/>
    <siteModel idref="firstSecondSiteModel"/>
    <branchRateModel idref="strictClock"/>
  </input>

  <input spec="TreeLikelihood" id="thirdCodonAlignment_likelihood">
    <data idref="thirdCodonPositions"/>
    <tree idref="tree"/>
    <siteModel idref="thirdSiteModel"/>
    <branchRateModel idref="strictClock"/>
  </input>

  <parameter id="firstSecondKappa" value="1.0" lower="0.0"/>
  <parameter id="firstSecondBaseFrequencies" dimension="4"
             value="0.25 0.25 0.25 0.25" lower="0.0" upper="1.0"/>
  <parameter id="thirdKappa" value="1.0" lower="0.0"/>
  <parameter id="thirdBaseFrequencies" dimension="4"
             value="0.25 0.25 0.25 0.25" lower="0.0" upper="1.0"/>
  <parameter id="populationSize" value="1.0" lower="0.0"/>

  <tree id="tree"/>

  <tree id="coalescentSimulator"
        spec="beast.base.evolution.tree.coalescent.RandomTree"
        initial="@tree" taxa="@Primates">
    <populationModel id="initialPopulation"
                     spec="beast.base.evolution.tree.coalescent.ConstantPopulation">
      <parameter estimate="false" name="popSize" value="1.0"/>
    </populationModel>
  </tree>

  <run spec="MCMC" id="mcmc" chainLength="10000000">
    <state id="state" storeEvery="1000">
      <stateNode idref="firstSecondKappa"/>
      <stateNode idref="firstSecondBaseFrequencies"/>
      <stateNode idref="thirdKappa"/>
      <stateNode idref="thirdBaseFrequencies"/>
      <stateNode idref="populationSize"/>
      <stateNode idref="tree"/>
    </state>

    <init idref="coalescentSimulator"/>

    <distribution id="posterior" spec="CompoundDistribution">
      <distribution id="prior" spec="CompoundDistribution">
        <distribution id="tree.prior"
                      spec="beast.base.evolution.tree.coalescent.Coalescent">
          <treeIntervals id="treeIntervals"
                         spec="beast.base.evolution.tree.TreeIntervals"
                         tree="@tree"/>
          <populationModel id="constantPopulation"
                           spec="beast.base.evolution.tree.coalescent.ConstantPopulation"
                           popSize="@populationSize"/>
        </distribution>

        <distribution id="firstSecondKappa_prior"
                      spec="beast.base.inference.distribution.Prior"
                      x="@firstSecondKappa">
          <distr id="firstSecondKappa_logNormal"
                 spec="beast.base.inference.distribution.LogNormalDistributionModel"
                 meanInRealSpace="false">
            <parameter estimate="false" name="M" value="1.0"/>
            <parameter estimate="false" name="S" value="0.5"/>
          </distr>
        </distribution>

        <distribution id="firstSecondBaseFrequencies_prior"
                      spec="beast.base.inference.distribution.Prior"
                      x="@firstSecondBaseFrequencies">
          <distr id="firstSecondBaseFrequencies_dirichlet"
                 spec="beast.base.inference.distribution.Dirichlet">
            <parameter dimension="4" estimate="false" name="alpha"
                       value="1.0 1.0 1.0 1.0"/>
          </distr>
        </distribution>

        <distribution id="thirdKappa_prior"
                      spec="beast.base.inference.distribution.Prior"
                      x="@thirdKappa">
          <distr id="thirdKappa_logNormal"
                 spec="beast.base.inference.distribution.LogNormalDistributionModel"
                 meanInRealSpace="false">
            <parameter estimate="false" name="M" value="1.0"/>
            <parameter estimate="false" name="S" value="0.5"/>
          </distr>
        </distribution>

        <distribution id="thirdBaseFrequencies_prior"
                      spec="beast.base.inference.distribution.Prior"
                      x="@thirdBaseFrequencies">
          <distr id="thirdBaseFrequencies_dirichlet"
                 spec="beast.base.inference.distribution.Dirichlet">
            <parameter dimension="4" estimate="false" name="alpha"
                       value="1.0 1.0 1.0 1.0"/>
          </distr>
        </distribution>

        <distribution id="populationSize_prior"
                      spec="beast.base.inference.distribution.Prior"
                      x="@populationSize">
          <distr id="populationSize_logNormal"
                 spec="beast.base.inference.distribution.LogNormalDistributionModel"
                 meanInRealSpace="false">
            <parameter estimate="false" name="M" value="0.0"/>
            <parameter estimate="false" name="S" value="1.0"/>
          </distr>
        </distribution>
      </distribution>

      <distribution id="likelihood" spec="CompoundDistribution">
        <distribution idref="firstCodonAlignment_likelihood"/>
        <distribution idref="secondCodonAlignment_likelihood"/>
        <distribution idref="thirdCodonAlignment_likelihood"/>
      </distribution>
    </distribution>

    <operator id="firstSecondKappaScaler" spec="ScaleOperator"
              scaleFactor="0.5" weight="1.0"
              parameter="@firstSecondKappa"/>
    <operator id="firstSecondFrequenciesExchanger"
              spec="DeltaExchangeOperator" delta="0.01" weight="1.0">
      <parameter idref="firstSecondBaseFrequencies"/>
    </operator>
    <operator id="thirdKappaScaler" spec="ScaleOperator"
              scaleFactor="0.5" weight="1.0"
              parameter="@thirdKappa"/>
    <operator id="thirdFrequenciesExchanger"
              spec="DeltaExchangeOperator" delta="0.01" weight="1.0">
      <parameter idref="thirdBaseFrequencies"/>
    </operator>
    <operator id="populationSizeScaler" spec="ScaleOperator"
              scaleFactor="0.5" weight="1.0"
              parameter="@populationSize"/>

    <operator id="treeScaler" spec="ScaleOperator"
              scaleFactor="0.5" weight="1.0" tree="@tree"/>
    <operator id="uniform"
              spec="beast.base.evolution.operator.Uniform"
              weight="10.0" tree="@tree"/>
    <operator id="subtreeSlide" spec="SubtreeSlide"
              weight="5.0" gaussian="true" size="1.0" tree="@tree"/>
    <operator id="narrow" spec="Exchange"
              isNarrow="true" weight="1.0" tree="@tree"/>
    <operator id="wide" spec="Exchange"
              isNarrow="false" weight="1.0" tree="@tree"/>
    <operator id="wilsonBalding" spec="WilsonBalding"
              weight="1.0" tree="@tree"/>

    <logger id="tracelog" logEvery="1000"
            fileName="testSRD06-beast2.log"
            model="@posterior" sanitiseHeaders="true">
      <log idref="posterior"/>
      <log idref="prior"/>
      <log idref="likelihood"/>
      <log idref="firstCodonAlignment_likelihood"/>
      <log idref="secondCodonAlignment_likelihood"/>
      <log idref="thirdCodonAlignment_likelihood"/>
      <log idref="tree.prior"/>
      <log idref="firstSecondKappa_prior"/>
      <log idref="firstSecondBaseFrequencies_prior"/>
      <log idref="thirdKappa_prior"/>
      <log idref="thirdBaseFrequencies_prior"/>
      <log idref="populationSize_prior"/>
      <log idref="firstSecondKappa"/>
      <log idref="firstSecondBaseFrequencies"/>
      <log idref="thirdKappa"/>
      <log idref="thirdBaseFrequencies"/>
      <log idref="populationSize"/>
      <log id="tree.statistics"
           spec="beast.base.evolution.tree.TreeStatLogger"
           tree="@tree"/>
    </logger>

    <logger id="treelog" logEvery="1000"
            fileName="testSRD06-beast2.trees" mode="tree">
      <log id="treeWithMetaData"
           spec="beast.base.evolution.TreeWithMetaDataLogger"
           tree="@tree"/>
    </logger>

    <logger id="screenlog" logEvery="100000">
      <log idref="posterior"/>
      <log idref="prior"/>
      <log idref="likelihood"/>
      <log idref="firstSecondKappa"/>
      <log idref="thirdKappa"/>
      <log idref="populationSize"/>
    </logger>
  </run>
</beast>
