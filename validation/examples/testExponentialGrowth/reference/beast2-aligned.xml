    <!-- The HKY substitution model (Hasegawa, Kishino & Yano, 1985)             -->
    <input spec='HKY' id='hky'>
        <kappa idref='hky.kappa'/>
        <frequencies id='freqs' spec='Frequencies'
                     frequencies='@hky.frequencies'/>
    </input>

    <!-- site model                                                              -->
    <input spec='SiteModel' id="siteModel" gammaCategoryCount='1'>
        <!--
            <parameter name='shape' id='shape' value='0.5'/>
            <parameter name='proportionInvariant' id='propInvar' value='0.2'/>
        -->
        <substModel idref='hky'/>
    </input>

    <input spec='TreeLikelihood' id="treeLikelihood">
        <data idref="alignment"/>
        <tree idref="tree"/>
        <siteModel idref="siteModel"/>
        <branchRateModel id="strictClock"
                         spec="beast.base.evolution.branchratemodel.StrictClockModel">
            <parameter estimate="false" id="clockRate"
                       name="clock.rate" value="1.0"/>
        </branchRateModel>
    </input>

    <parameter id="hky.kappa" value="0.5" lower="0.0"/>
    <parameter id="hky.frequencies" dimension="4" value="0.25 0.25 0.25 0.25"
               lower="0.0" upper="1.0"/>
    <parameter id="populationSize" value="1.0" lower="0.0"/>
    <parameter id="growthRate" value="1.0" lower="0.0"/>

    <tree id='tree'/>

    <tree spec='beast.base.evolution.tree.ClusterTree' id='upgmatree' clusterType='upgma' initial='@tree'>
        <taxa idref='alignment'/>
    </tree>
    <tree spec='beast.base.evolution.tree.coalescent.RandomTree' id='coalescentSimulator' initial='@tree' taxa='@alignment'>
        <populationModel spec='ConstantPopulation'>
            <popSize spec='parameter.RealParameter' value='1'/>
        </populationModel>
    </tree>


    <!--
        Controlled comparison model aligned to testExponentialGrowth.phylospec:
        * kappa ~ LogNormal(logMean=1.0, logSd=0.5)
        * frequencies ~ Dirichlet(1,1,1,1)
        * populationSize ~ LogNormal(logMean=0.0, logSd=1.0)
        * growthRate ~ LogNormal(logMean=0.0, logSd=1.0)
        * tree ~ Coalescent(ExponentialGrowth(populationSize, growthRate))
        * strict clock rate fixed to 1.0
    -->
    <run spec="MCMC" id="mcmc" chainLength="10000000">
        <state id="state" storeEvery="1000">
            <stateNode idref="hky.kappa"/>
            <stateNode idref="hky.frequencies"/>
            <stateNode idref="populationSize"/>
            <stateNode idref="growthRate"/>
            <stateNode idref="tree"/>
        </state>

        <init idref="coalescentSimulator"/>

        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="tree.prior"
                              spec="beast.base.evolution.tree.coalescent.Coalescent">
                    <treeIntervals id="treeIntervals"
                                   spec="beast.base.evolution.tree.TreeIntervals"
                                   tree="@tree"/>
                    <populationModel id="exponentialPopulation"
                                     spec="beast.base.evolution.tree.coalescent.ExponentialGrowth"
                                     popSize="@populationSize"
                                     growthRate="@growthRate"/>
                </distribution>

                <distribution id="kappa.prior"
                              spec="beast.base.inference.distribution.Prior"
                              x="@hky.kappa">
                    <distr id="kappa.logNormal"
                           spec="beast.base.inference.distribution.LogNormalDistributionModel"
                           meanInRealSpace="false">
                        <parameter estimate="false" name="M" value="1.0"/>
                        <parameter estimate="false" name="S" value="0.5"/>
                    </distr>
                </distribution>

                <distribution id="frequencies.prior"
                              spec="beast.base.inference.distribution.Prior"
                              x="@hky.frequencies">
                    <distr id="frequencies.dirichlet"
                           spec="beast.base.inference.distribution.Dirichlet">
                        <parameter dimension="4" estimate="false"
                                   name="alpha" value="1.0 1.0 1.0 1.0"/>
                    </distr>
                </distribution>

                <distribution id="populationSize.prior"
                              spec="beast.base.inference.distribution.Prior"
                              x="@populationSize">
                    <distr id="populationSize.logNormal"
                           spec="beast.base.inference.distribution.LogNormalDistributionModel"
                           meanInRealSpace="false">
                        <parameter estimate="false" name="M" value="0.0"/>
                        <parameter estimate="false" name="S" value="1.0"/>
                    </distr>
                </distribution>

                <distribution id="growthRate.prior"
                              spec="beast.base.inference.distribution.Prior"
                              x="@growthRate">
                    <distr id="growthRate.logNormal"
                           spec="beast.base.inference.distribution.LogNormalDistributionModel"
                           meanInRealSpace="false">
                        <parameter estimate="false" name="M" value="0.0"/>
                        <parameter estimate="false" name="S" value="1.0"/>
                    </distr>
                </distribution>
            </distribution>

            <distribution id="likelihood" idref="treeLikelihood"/>
        </distribution>

        <operator id="kappaScaler" spec="ScaleOperator"
                  scaleFactor="0.5" weight="1.0"
                  parameter="@hky.kappa"/>

        <operator id="frequenciesExchanger" spec="DeltaExchangeOperator"
                  delta="0.01" weight="1.0">
            <parameter idref="hky.frequencies"/>
        </operator>

        <operator id="populationSizeScaler" spec="ScaleOperator"
                  scaleFactor="0.5" weight="1.0"
                  parameter="@populationSize"/>

        <operator id="growthRateScaler" spec="ScaleOperator"
                  scaleFactor="0.5" weight="1.0"
                  parameter="@growthRate"/>

        <operator id="treeScaler" spec="ScaleOperator"
                  scaleFactor="0.5" weight="1.0" tree="@tree"/>
        <operator id="uniform" spec="Uniform"
                  weight="10.0" tree="@tree"/>
        <operator id="subtreeSlide" spec="SubtreeSlide"
                  weight="5.0" gaussian="true" size="1.0" tree="@tree"/>
        <operator id="narrow" spec="Exchange"
                  isNarrow="true" weight="1.0" tree="@tree"/>
        <operator id="wide" spec="Exchange"
                  isNarrow="false" weight="1.0" tree="@tree"/>
        <operator id="wilsonBalding" spec="WilsonBalding"
                  weight="1.0" tree="@tree"/>

        <logger id="tracelog" logEvery="1000"
                fileName="testExponentialGrowth-beast2.log"
                model="@posterior" sanitiseHeaders="true">
            <log idref="posterior"/>
            <log idref="prior"/>
            <log idref="likelihood"/>
            <log idref="tree.prior"/>
            <log idref="kappa.prior"/>
            <log idref="frequencies.prior"/>
            <log idref="populationSize.prior"/>
            <log idref="growthRate.prior"/>
            <log idref="hky.kappa"/>
            <log idref="hky.frequencies"/>
            <log idref="populationSize"/>
            <log idref="growthRate"/>
            <log id="tree.statistics"
                 spec="beast.base.evolution.tree.TreeStatLogger"
                 tree="@tree"/>
        </logger>

        <logger id="treelog" logEvery="1000"
                fileName="testExponentialGrowth-beast2.trees" mode="tree">
            <log id="treeWithMetaData"
                 spec="beast.base.evolution.TreeWithMetaDataLogger"
                 tree="@tree"/>
        </logger>

        <logger id="screenlog" logEvery="100000">
            <log idref="posterior"/>
            <log idref="prior"/>
            <log idref="likelihood"/>
            <log idref="hky.kappa"/>
            <log idref="populationSize"/>
            <log idref="growthRate"/>
        </logger>
    </run>

</beast>
