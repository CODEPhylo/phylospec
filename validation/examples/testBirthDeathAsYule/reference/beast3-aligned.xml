<?xml version="1.0" encoding="UTF-8"?>
<beast version="2.8"
       namespace="beast.pkgmgmt:beast.base.core:beast.base.inference:
       beast.base.evolution.alignment:beast.base.evolution.tree:
       beast.base.spec.evolution.speciation:
       beast.base.spec.inference.operator:beast.base.spec.inference.parameter:
       beast.base.spec.inference.distribution">

    <data id="alignment" spec="Alignment" dataType="nucleotide">
        <sequence taxon="A" value="A"/>
        <sequence taxon="B" value="A"/>
        <sequence taxon="C" value="A"/>
        <sequence taxon="D" value="A"/>
        <sequence taxon="E" value="A"/>
        <sequence taxon="F" value="A"/>
        <sequence taxon="G" value="A"/>
        <sequence taxon="H" value="A"/>
        <sequence taxon="I" value="A"/>
        <sequence taxon="J" value="A"/>
    </data>

    <parameter id="birthRate"
               spec="RealScalarParam"
               domain="PositiveReal"
               value="1.0"/>
    <parameter id="relativeDeathRate"
               spec="RealScalarParam"
               domain="NonNegativeReal"
               value="0.0"/>
    <parameter id="sampleProbability"
               spec="RealScalarParam"
               domain="UnitInterval"
               value="1.0"/>

    <input id="birthDeath"
           spec="beast.base.spec.evolution.speciation.BirthDeathGernhard08Model"
           type="unscaled"
           birthDiffRate="@birthRate"
           relativeDeathRate="@relativeDeathRate"
           sampleProbability="@sampleProbability"
           tree="@tree"/>

    <run id="mcmc" spec="MCMC" chainLength="10000000">
        <state id="state">
            <stateNode id="tree"
                       spec="beast.base.spec.evolution.tree.coalescent.RandomTree">
                <taxa idref="alignment"/>
                <populationModel id="initialPopulation"
                                 spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
                    <popSize spec="RealScalarParam"
                             domain="PositiveReal"
                             value="1.0"/>
                </populationModel>
                <taxonset id="taxonSet"
                          spec="TaxonSet"
                          alignment="@alignment"/>
            </stateNode>
            <stateNode idref="birthRate"/>
        </state>

        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="tree.prior" idref="birthDeath"/>
                <distribution id="birthRate.prior"
                              spec="beast.base.spec.inference.distribution.LogNormal"
                              param="@birthRate">
                    <M spec="RealScalarParam" domain="Real" value="0.0"/>
                    <S spec="RealScalarParam"
                       domain="PositiveReal" value="1.0"/>
                </distribution>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution"/>
        </distribution>

        <operator id="birthRateScaler"
                  spec="beast.base.spec.inference.operator.ScaleOperator"
                  scaleFactor="0.75"
                  weight="1.0"
                  parameter="@birthRate"/>
        <operator id="treeScaler"
                  spec="beast.base.spec.evolution.operator.ScaleTreeOperator"
                  scaleFactor="0.75"
                  weight="5.0"
                  tree="@tree"/>
        <operator id="uniform"
                  spec="beast.base.evolution.operator.kernel.BactrianNodeOperator"
                  weight="30.0"
                  tree="@tree"/>
        <operator id="subtreeSlide"
                  spec="beast.base.evolution.operator.kernel.BactrianSubtreeSlide"
                  weight="15.0"
                  tree="@tree"/>
        <operator id="narrow"
                  spec="beast.base.evolution.operator.Exchange"
                  isNarrow="true"
                  weight="15.0"
                  tree="@tree"/>
        <operator id="wide"
                  spec="beast.base.evolution.operator.Exchange"
                  isNarrow="false"
                  weight="5.0"
                  tree="@tree"/>
        <operator id="wilsonBalding"
                  spec="beast.base.evolution.operator.WilsonBalding"
                  weight="5.0"
                  tree="@tree"/>

        <logger id="trace"
                logEvery="1000"
                fileName="testBirthDeathAsYule-beast3-reference.log">
            <log idref="posterior"/>
            <log idref="prior"/>
            <log idref="likelihood"/>
            <log idref="tree.prior"/>
            <log idref="birthRate.prior"/>
            <log idref="birthRate"/>
            <log id="tree.statistics"
                 spec="beast.base.evolution.tree.TreeStatLogger"
                 tree="@tree"/>
        </logger>

        <logger id="trees"
                logEvery="1000"
                fileName="testBirthDeathAsYule-beast3-reference.trees"
                mode="tree">
            <log idref="tree"/>
        </logger>

        <logger id="screen" logEvery="100000">
            <log idref="posterior"/>
            <log idref="prior"/>
            <log idref="tree.prior"/>
            <log idref="birthRate"/>
        </logger>
    </run>
</beast>
