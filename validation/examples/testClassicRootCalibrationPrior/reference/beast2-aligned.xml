<?xml version="1.0" standalone="yes"?>
<beast version="2.0"
       namespace="beast.base.evolution.alignment:beast.base.evolution.speciation:beast.pkgmgmt:beast.base.core:beast.base.inference:beast.base.evolution.tree:beast.base.evolution.tree.coalescent:beast.base.util:beast.base.math:beast.base.inference.distribution:beast.base.evolution.likelihood:beast.base.evolution.branchratemodel:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.operator:beast.base.inference.operator">

    <data id="alignment" dataType="nucleotide">
        <sequence taxon="taxon1">A</sequence>
        <sequence taxon="taxon2">A</sequence>
        <sequence taxon="taxon3">A</sequence>
        <sequence taxon="taxon4">A</sequence>
    </data>

    <parameter id="birthRate" value="1.0" lower="0.0"/>

    <input id="yule" spec="beast.base.evolution.speciation.YuleModel"
           birthDiffRate="@birthRate">
        <tree id="tree" spec="beast.base.evolution.tree.TreeParser"
              IsLabelledNewick="true" taxa="@alignment"
              newick="(((taxon1:1.0,taxon2:1.0):1.0,taxon3:2.0):1.0,taxon4:3.0);"/>
    </input>

    <distribution id="rootCalibration"
                  spec="beast.base.evolution.tree.MRCAPrior"
                  tree="@tree" monophyletic="true">
        <taxonset id="allTaxa" spec="TaxonSet" alignment="@alignment"/>
        <distr id="rootCalibration.uniform"
               spec="beast.base.inference.distribution.Uniform"
               lower="0.0" upper="10.0"/>
    </distribution>

    <input id="siteModel" spec="SiteModel" gammaCategoryCount="1">
        <substModel id="jc69" spec="JukesCantor"/>
    </input>

    <input id="treeLikelihood" spec="TreeLikelihood"
           data="@alignment" tree="@tree" siteModel="@siteModel">
        <branchRateModel id="strictClock"
                         spec="beast.base.evolution.branchratemodel.StrictClockModel">
            <parameter id="clockRate" estimate="false"
                       name="clock.rate" value="1.0"/>
        </branchRateModel>
    </input>

    <!--
        Controlled comparison model:
        * birthRate ~ LogNormal(logMean=0.0, logSd=1.0)
        * tree ~ Yule(birthRate)
        * rootAge(tree) ~ Uniform(0.0, 10.0)
        * JC69 likelihood with a fixed unit strict clock
    -->
    <run id="mcmc" spec="MCMC" chainLength="5000000">
        <state id="state" storeEvery="500">
            <stateNode idref="tree"/>
            <stateNode idref="birthRate"/>
        </state>

        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="yule.prior" idref="yule"/>
                <distribution id="birthRate.prior"
                              spec="beast.base.inference.distribution.Prior"
                              x="@birthRate">
                    <distr id="birthRate.logNormal"
                           spec="beast.base.inference.distribution.LogNormalDistributionModel"
                           M="0.0" S="1.0" meanInRealSpace="false"/>
                </distribution>
                <distribution idref="rootCalibration"/>
            </distribution>
            <distribution id="likelihood" idref="treeLikelihood"/>
        </distribution>

        <operator id="birthRateScaler" spec="ScaleOperator"
                  scaleFactor="0.5" weight="1.0"
                  parameter="@birthRate"/>
        <operator id="treeScaler" spec="ScaleOperator"
                  scaleFactor="0.5" weight="1.0" tree="@tree"/>
        <operator id="uniform"
                  spec="beast.base.evolution.operator.Uniform"
                  weight="10.0" tree="@tree"/>
        <operator id="subtreeSlide" spec="SubtreeSlide"
                  weight="5.0" gaussian="true" size="1.0" tree="@tree"/>
        <operator id="narrow" spec="Exchange"
                  isNarrow="true" weight="1.0" tree="@tree"/>
        <operator id="wide" spec="Exchange"
                  isNarrow="false" weight="1.0" tree="@tree"/>
        <operator id="wilsonBalding" spec="WilsonBalding"
                  weight="1.0" tree="@tree"/>

        <logger id="tracelog" logEvery="500"
                fileName="testClassicRootCalibrationPrior-beast2.log"
                model="@posterior" sanitiseHeaders="true">
            <log idref="posterior"/>
            <log idref="prior"/>
            <log idref="likelihood"/>
            <log idref="yule.prior"/>
            <log idref="birthRate.prior"/>
            <log idref="rootCalibration"/>
            <log idref="birthRate"/>
            <log id="rootAge"
                 spec="beast.base.evolution.tree.MRCAPrior"
                 tree="@tree" taxonset="@allTaxa"/>
            <log id="tree.statistics"
                 spec="beast.base.evolution.tree.TreeStatLogger"
                 tree="@tree"/>
        </logger>

        <logger id="treelog" logEvery="500"
                fileName="testClassicRootCalibrationPrior-beast2.trees"
                mode="tree">
            <log id="treeWithMetaData"
                 spec="beast.base.evolution.TreeWithMetaDataLogger"
                 tree="@tree"/>
        </logger>

        <logger id="screenlog" logEvery="50000">
            <log idref="posterior"/>
            <log idref="prior"/>
            <log idref="likelihood"/>
            <log idref="birthRate"/>
        </logger>
    </run>
</beast>
