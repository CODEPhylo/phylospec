<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<beast version="2.0"
 namespace="beast.base.evolution.alignment:beast.pkgmgmt:beast.base.core:beast.base.inference:beast.base.evolution.tree:beast.base.evolution.tree.coalescent:beast.base.inference.distribution:beast.base.evolution.operator:beast.base.inference.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.likelihood">
<!-- Controlled dated-tip comparison derived from BEAST 2 testTipDates.xml. -->
<data dataType="nucleotide" id="alignment">
<sequence taxon="D4Brazi82">

            
        </sequence>
<sequence taxon="D4ElSal83">

            
        </sequence>
<sequence taxon="D4ElSal94">

            
        </sequence>
<sequence taxon="D4Indon76">

            
        </sequence>
<sequence taxon="D4Indon77">

            
        </sequence>
<sequence taxon="D4Mexico84">

            
        </sequence>
<sequence taxon="D4NewCal81">

            
        </sequence>
<sequence taxon="D4Philip64">

            
        </sequence>
<sequence taxon="D4Philip56">

            
        </sequence>
<sequence taxon="D4Philip84">

            
        </sequence>
<sequence taxon="D4PRico86">

            
        </sequence>
<sequence taxon="D4SLanka78">

            
        </sequence>
<sequence taxon="D4Tahiti79">

            
        </sequence>
<sequence taxon="D4Tahiti85">

            
        </sequence>
<sequence taxon="D4Thai63">

            
        </sequence>
<sequence taxon="D4Thai78">

            
        </sequence>
<sequence taxon="D4Thai84">

            
        </sequence>
</data>

<input id="hky" spec="HKY">
  <parameter idref="hky.kappa" name="kappa"/>
  <frequencies id="baseFrequencies" spec="Frequencies">
    <parameter dimension="4" estimate="false" name="frequencies" value="0.25 0.25 0.25 0.25"/>
  </frequencies>
</input>
<input id="siteModel" spec="SiteModel" gammaCategoryCount="1"><substModel idref="hky"/></input>
<parameter id="hky.kappa" value="2.0" lower="0.0"/>
<parameter id="populationSize" value="20.0" lower="0.0"/>
<parameter id="clockRate" value="0.01" lower="0.0"/>
<tree id="tree" spec="beast.base.evolution.tree.ClusterTree" clusterType="upgma">
  <trait id="dateTrait" spec="beast.base.evolution.tree.TraitSet"
         traitname="date-forward" units="year"
         value="D4Brazi82=1982,D4ElSal83=1983,D4ElSal94=1994,D4Indon76=1976,D4Indon77=1977,D4Mexico84=1984,D4NewCal81=1981,D4Philip64=1964,D4Philip56=1956,D4Philip84=1984,D4PRico86=1986,D4SLanka78=1978,D4Tahiti79=1979,D4Tahiti85=1985,D4Thai63=1963,D4Thai78=1978,D4Thai84=1984">
    <taxa id="datedTaxa" spec="TaxonSet" alignment="@alignment"/>
  </trait>
  <input name="taxa" idref="alignment"/>
</tree>
<input id="strictClock" spec="beast.base.evolution.branchratemodel.StrictClockModel">
  <parameter idref="clockRate" name="clock.rate"/>
</input>
<input id="treeLikelihood" spec="TreeLikelihood" data="@alignment" tree="@tree"
       siteModel="@siteModel" branchRateModel="@strictClock"/>
<run id="mcmc" spec="MCMC" chainLength="10000000">
  <state id="state" storeEvery="1000">
    <stateNode idref="hky.kappa"/>
    <stateNode idref="populationSize"/>
    <stateNode idref="clockRate"/>
    <stateNode idref="tree"/>
  </state>
  <distribution id="posterior" spec="CompoundDistribution">
    <distribution id="prior" spec="CompoundDistribution">
      <distribution id="tree.prior" spec="beast.base.evolution.tree.coalescent.Coalescent">
        <treeIntervals id="treeIntervals" spec="beast.base.evolution.tree.TreeIntervals" tree="@tree"/>
        <populationModel id="constantPopulation"
          spec="beast.base.evolution.tree.coalescent.ConstantPopulation" popSize="@populationSize"/>
      </distribution>
      <distribution id="kappa.prior" spec="beast.base.inference.distribution.Prior" x="@hky.kappa">
        <distr id="kappa.logNormal" spec="beast.base.inference.distribution.LogNormalDistributionModel"
               meanInRealSpace="false">
          <parameter estimate="false" name="M" value="1.0"/>
          <parameter estimate="false" name="S" value="0.5"/>
        </distr>
      </distribution>
      <distribution id="populationSize.prior" spec="beast.base.inference.distribution.Prior" x="@populationSize">
        <distr id="populationSize.logNormal" spec="beast.base.inference.distribution.LogNormalDistributionModel"
               meanInRealSpace="false">
          <parameter estimate="false" name="M" value="3.0"/>
          <parameter estimate="false" name="S" value="1.0"/>
        </distr>
      </distribution>
      <distribution id="clockRate.prior" spec="beast.base.inference.distribution.Prior" x="@clockRate">
        <distr id="clockRate.logNormal" spec="beast.base.inference.distribution.LogNormalDistributionModel"
               meanInRealSpace="false">
          <parameter estimate="false" name="M" value="-4.6"/>
          <parameter estimate="false" name="S" value="0.5"/>
        </distr>
      </distribution>
    </distribution>
    <distribution id="likelihood" idref="treeLikelihood"/>
  </distribution>
  <operator id="kappaScaler" spec="ScaleOperator" parameter="@hky.kappa"
            scaleFactor="0.5" weight="1.0"/>
  <operator id="populationSizeScaler" spec="ScaleOperator" parameter="@populationSize"
            scaleFactor="0.5" weight="3.0"/>
  <operator id="clockRateScaler" spec="ScaleOperator" parameter="@clockRate"
            scaleFactor="0.5" weight="3.0"/>
  <operator id="upDown" spec="UpDownOperator" scaleFactor="0.75" weight="3.0">
    <parameter idref="clockRate" name="up"/>
    <tree idref="tree" name="down"/>
  </operator>
  <operator id="treeScaler" spec="ScaleOperator" tree="@tree" scaleFactor="0.75" weight="3.0"/>
  <operator id="uniform" spec="beast.base.evolution.operator.Uniform" tree="@tree" weight="30.0"/>
  <operator id="subtreeSlide" spec="SubtreeSlide" tree="@tree"
            gaussian="true" size="1.0" weight="15.0"/>
  <operator id="narrow" spec="Exchange" tree="@tree" isNarrow="true" weight="15.0"/>
  <operator id="wide" spec="Exchange" tree="@tree" isNarrow="false" weight="3.0"/>
  <operator id="wilsonBalding" spec="WilsonBalding" tree="@tree" weight="3.0"/>
  <logger id="tracelog" fileName="testTipDates-beast2.log" logEvery="1000"
          model="@posterior" sanitiseHeaders="true">
    <log idref="posterior"/><log idref="prior"/><log idref="likelihood"/>
    <log idref="tree.prior"/><log idref="kappa.prior"/>
    <log idref="populationSize.prior"/><log idref="clockRate.prior"/>
    <log idref="hky.kappa"/><log idref="populationSize"/><log idref="clockRate"/>
    <log id="tree.statistics" spec="beast.base.evolution.tree.TreeStatLogger" tree="@tree"/>
  </logger>
  <logger id="treelog" fileName="testTipDates-beast2.trees" logEvery="1000" mode="tree">
    <log id="treeWithMetaData" spec="beast.base.evolution.TreeWithMetaDataLogger" tree="@tree"/>
  </logger>
  <logger id="screenlog" logEvery="100000">
    <log idref="posterior"/><log idref="prior"/><log idref="likelihood"/>
    <log idref="hky.kappa"/><log idref="populationSize"/><log idref="clockRate"/>
  </logger>
</run>
</beast>
