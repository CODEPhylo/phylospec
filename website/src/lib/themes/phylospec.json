{
  "name": "phylospec",
  "scopeName": "source.phylospec",
  "fileTypes": [
    ".phylospec"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.phylospec",
          "match": "//.*$"
        },
        {
          "name": "comment.block.phylospec",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.phylospec",
          "match": "@[\\p{ID_Start}_\\x{2E2F}][\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]]*(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])",
          "captures": {
            "0": {
              "name": "entity.name.function.decorator.phylospec"
            }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.phylospec",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])(import)(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])\\s+([\\p{ID_Start}_\\x{2E2F}][\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]]*(?:\\.[\\p{ID_Start}_\\x{2E2F}][\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]]*)*)(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])",
          "captures": {
            "1": {
              "name": "keyword.control.import.phylospec"
            },
            "2": {
              "name": "entity.name.namespace.phylospec"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.phylospec",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])(import)(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])"
        },
        {
          "name": "keyword.control.phylospec",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])(for)(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])"
        },
        {
          "name": "keyword.control.phylospec",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])(in)(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])"
        },
        {
          "name": "keyword.control.phylospec",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])(observed as)(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])"
        },
        {
          "name": "keyword.control.phylospec",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])(observed between)(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])"
        },
        {
          "name": "keyword.control.phylospec",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])(per)(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.phylospec",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])[\\p{Lu}\\p{Lt}][\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]]*(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])(?=\\s+[\\p{ID_Start}_\\x{2E2F}])"
        },
        {
          "name": "meta.type.generic.phylospec",
          "begin": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])([\\p{Lu}\\p{Lt}][\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]]*)\\s*(<)",
          "end": "(>)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.type.phylospec"
            },
            "2": {
              "name": "punctuation.definition.typeparameters.begin.phylospec"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.typeparameters.end.phylospec"
            }
          },
          "patterns": [
            {
              "include": "#types"
            },
            {
              "name": "punctuation.separator.comma.phylospec",
              "match": ","
            },
            {
              "name": "entity.name.type.phylospec",
              "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])[\\p{Lu}\\p{Lt}][\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]]*(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])"
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.phylospec",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])[\\p{ID_Start}_\\x{2E2F}][\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.stochastic.phylospec",
          "match": "~"
        },
        {
          "name": "keyword.operator.assignment.phylospec",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.phylospec",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.phylospec",
          "match": "\\+|\\-|\\*|\\/"
        },
        {
          "name": "keyword.operator.logical.phylospec",
          "match": "!"
        },
        {
          "name": "constant.numeric",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])Myr(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])"
        },
        {
          "name": "constant.numeric",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])yr(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.phylospec",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.phylospec",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.phylospec",
              "match": "(\\$\\{)([\\p{ID_Start}_\\x{2E2F}][\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]]*)(\\})",
              "captures": {
                "1": {
                  "name": "punctuation.definition.template-expression.begin.phylospec"
                },
                "2": {
                  "name": "variable.other.phylospec"
                },
                "3": {
                  "name": "punctuation.definition.template-expression.end.phylospec"
                }
              }
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.phylospec",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.phylospec",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.phylospec",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])(true|false)(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.phylospec",
          "match": "(?<![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])[\\p{ID_Start}_\\x{2E2F}][\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]]*(?![\\p{ID_Continue}\\x{2E2F}&&[^\\p{Cf}]])"
        }
      ]
    }
  }
}